VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
# Fond des nouvelles finales : gris par detourage serveur, sans appel image supplementaire.
# original permet de conserver le decor en cas de contrainte d'hebergement.
PORTRAIT_BACKGROUND_MODE=gray
OPENAI_DAILY_TRIAL_LIMIT=1
OPENAI_QUOTA_TIME_ZONE=Europe/Zurich
OPENAI_EXTRA_TRIAL_CODE=
OPENAI_EXTRA_TRIAL_CODES=
OPENAI_EXTRA_TRIAL_USES=5
VITE_API_PROXY_TARGET=http://127.0.0.1:8787

# Comptes utilisateurs / historique persistant
# Utiliser DATABASE_URL ou les variables MYSQL_*.
# En production, mettre REQUIRE_MYSQL=true pour refuser le fallback JSON.
DATABASE_URL=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
REQUIRE_MYSQL=false
# Reserve au developpement si NODE_ENV=production est simule localement.
ALLOW_JSON_USER_STORE=false

# Emails autorises a acceder au tableau administrateur.
# Exemple: MORPHOSTYLE_ADMIN_EMAILS=admin@domaine.com,second@domaine.com
MORPHOSTYLE_ADMIN_EMAILS=
