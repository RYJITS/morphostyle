{
  "name": "morphostyle-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "vite",
    "dev:api": "node -e \"process.env.PORT=process.env.PORT||'8787'; import('./server/index.mjs').then(m => m.startMorphoStyleServer())\"",
    "start": "node server.js",
    "prebuild": "node scripts/check-demo-profile-assets.mjs && node scripts/prepare-portrait-matting.mjs",
    "build": "tsc && vite build",
    "check:demo-assets": "node scripts/check-demo-profile-assets.mjs",
    "lint": "tsc --noEmit",
    "prepare:portrait-background": "node scripts/prepare-portrait-matting.mjs",
    "test:portrait-background": "node scripts/test-portrait-background.mjs",
    "preview": "vite preview",
    "validate:recipes": "node scripts/validate-preview-recipes.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.34.0",
    "express": "^5.2.1",
    "lucide-react": "^0.462.0",
    "mysql2": "^3.24.2",
    "onnxruntime-node": "1.29.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^8.0.16"
  }
}
